
from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination

# Create Bayesian Network
model = DiscreteBayesianNetwork([
    ('Obesity', 'Diabetes'),
    ('HighSugar', 'Diabetes')
])

# CPT for Obesity
cpd_obesity = TabularCPD(
    variable='Obesity',
    variable_card=2,
    values=[[0.7],
            [0.3]]
)

# CPT for High Blood Sugar
cpd_sugar = TabularCPD(
    variable='HighSugar',
    variable_card=2,
    values=[[0.6],
            [0.4]]
)

# CPT for Diabetes
# Evidence order: Obesity, HighSugar
cpd_diabetes = TabularCPD(
    variable='Diabetes',
    variable_card=2,
    values=[
        [0.95, 0.70, 0.60, 0.20],  # Diabetes = No
        [0.05, 0.30, 0.40, 0.80]   # Diabetes = Yes
    ],
    evidence=['Obesity', 'HighSugar'],
    evidence_card=[2, 2]
)

# Add CPTs to model
model.add_cpds(cpd_obesity, cpd_sugar, cpd_diabetes)

# Check model
print("Model valid:", model.check_model())

# Perform inference
inference = VariableElimination(model)

result = inference.query(
    variables=['Diabetes'],
    evidence={
        'Obesity': 1,
        'HighSugar': 1
    }
)

print("\nProbability of Diabetes:")
print(result)
