# Q1: Fraud Detection Using Bayesian Network

# Install:
# pip install pgmpy

from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination


# 1. Construct Bayesian Network

model = DiscreteBayesianNetwork([
    ("Amount", "Fraud"),
    ("Location", "Fraud"),
    ("Device", "Fraud"),
    ("PreviousFraud", "Fraud")
])


# 2. Define CPT for Transaction Amount

cpd_amount = TabularCPD(
    variable="Amount",
    variable_card=2,
    values=[
        [0.70],
        [0.30]
    ],
    state_names={
        "Amount": ["Low", "High"]
    }
)


# CPT for Transaction Location

cpd_location = TabularCPD(
    variable="Location",
    variable_card=2,
    values=[
        [0.80],
        [0.20]
    ],
    state_names={
        "Location": ["Known", "Unknown"]
    }
)


# CPT for Customer Login Device

cpd_device = TabularCPD(
    variable="Device",
    variable_card=2,
    values=[
        [0.75],
        [0.25]
    ],
    state_names={
        "Device": ["Known", "Unknown"]
    }
)


# CPT for Previous Fraud History

cpd_previous_fraud = TabularCPD(
    variable="PreviousFraud",
    variable_card=2,
    values=[
        [0.85],
        [0.15]
    ],
    state_names={
        "PreviousFraud": ["No", "Yes"]
    }
)


# CPT for Fraud
# P(Fraud | Amount, Location, Device, PreviousFraud)

cpd_fraud = TabularCPD(
    variable="Fraud",
    variable_card=2,
    values=[
        [0.99, 0.95, 0.90, 0.80,
         0.90, 0.80, 0.70, 0.50,
         0.85, 0.70, 0.60, 0.40,
         0.70, 0.50, 0.30, 0.10],

        [0.01, 0.05, 0.10, 0.20,
         0.10, 0.20, 0.30, 0.50,
         0.15, 0.30, 0.40, 0.60,
         0.30, 0.50, 0.70, 0.90]
    ],
    evidence=[
        "Amount",
        "Location",
        "Device",
        "PreviousFraud"
    ],
    evidence_card=[2, 2, 2, 2],
    state_names={
        "Fraud": ["No", "Yes"],
        "Amount": ["Low", "High"],
        "Location": ["Known", "Unknown"],
        "Device": ["Known", "Unknown"],
        "PreviousFraud": ["No", "Yes"]
    }
)


# Add CPTs to the network

model.add_cpds(
    cpd_amount,
    cpd_location,
    cpd_device,
    cpd_previous_fraud,
    cpd_fraud
)


# Check whether the Bayesian Network is valid

print("Bayesian Network Valid:", model.check_model())


# 3. Perform probabilistic inference

inference = VariableElimination(model)

result = inference.query(
    variables=["Fraud"],
    evidence={
        "Amount": "High",
        "Location": "Unknown",
        "Device": "Unknown",
        "PreviousFraud": "Yes"
    }
)


print("\nFraud Probability:")
print(result)


# 4. Predict the transaction

fraud_probability = result.values[1]

if fraud_probability >= 0.50:
    print("\nPrediction: FRAUDULENT TRANSACTION")
else:
    print("\nPrediction: LEGITIMATE TRANSACTION")
